---
import { BREVO_FORM_ACTION, SITE } from '../config';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const live = BREVO_FORM_ACTION.startsWith('https://');
---
<section class:list={['subscribe', { compact }]} id="subscribe">
  {!compact && <p class="eyebrow">The newsletter</p>}
  <h2>{compact ? 'Get the next issue' : 'New issues by email'}</h2>
  <p class="lede">One email when a new piece is published. No tracking games; unsubscribe in one click.</p>
  {live ? (
    <!-- Brevo native form: a plain POST works without any script; Brevo runs double opt-in and redirects to /subscribed. -->
    <form method="POST" action={BREVO_FORM_ACTION} class="sub-form">
      <label class="sr" for={compact ? 'EMAIL-c' : 'EMAIL'}>Email address</label>
      <input id={compact ? 'EMAIL-c' : 'EMAIL'} type="email" name="EMAIL" required autocomplete="email" placeholder="you@company.com" />
      <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      <input type="hidden" name="locale" value="en" />
      <button class="btn" type="submit">Subscribe</button>
    </form>
    <p class="fine">You'll get a confirmation email first. Nothing arrives until you confirm.</p>
  ) : (
    <p><a class="btn" href={`mailto:${SITE.email}?subject=Subscribe`}>Subscribe by email</a></p>
  )}
  {!compact && <p class="fine" id="subscribe-status" role="status"></p>}
</section>
<style>
  .subscribe { padding: 40px 0; }
  .subscribe h2 { font-size: 2rem; margin: 10px 0 8px; }
  .compact h2 { font-size: 1.4rem; }
  .lede { color: inherit; opacity: .8; margin: 0 0 20px; max-width: 520px; }
  .sub-form { display: flex; gap: 10px; flex-wrap: wrap; max-width: 520px; }
  .sub-form input[type=email] { flex: 1 1 240px; min-width: 0; font: 16px var(--body); padding: 13px 14px; border-radius: 6px;
    border: 1px solid var(--line); background: #fff; color: var(--charcoal); }
  .sub-form input[type=email]:focus { outline: 2px solid var(--teal); outline-offset: 1px; }
  .fine { font-size: 13px; opacity: .65; margin-top: 10px; }
  .hp { position: absolute; left: -5000px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>

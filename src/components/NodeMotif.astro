---
// The connected-node motif: a small graph of nodes with one active (teal) path and an orange accent node.
interface Props { class?: string; width?: number; }
const { class: cls = '', width = 520 } = Astro.props;
---
<svg class={cls} width={width} viewBox="0 0 520 320" fill="none" role="img" aria-label="Connected nodes" xmlns="http://www.w3.org/2000/svg">
  <g stroke="currentColor" stroke-opacity=".22" stroke-width="1.5">
    <path d="M40 260 L150 190 L270 220 L380 120 L480 160" />
    <path d="M150 190 L190 70 L380 120" />
    <path d="M270 220 L330 290" />
    <path d="M40 260 L90 120 L190 70" />
  </g>
  <path d="M40 260 L150 190 L270 220 L380 120 L480 160" stroke="#10B5A6" stroke-width="2.5" stroke-dasharray="6 7" />
  <g fill="currentColor" fill-opacity=".35">
    <circle cx="90" cy="120" r="5" /><circle cx="190" cy="70" r="6" /><circle cx="330" cy="290" r="5" />
  </g>
  <g fill="#10B5A6"><circle cx="40" cy="260" r="8" /><circle cx="150" cy="190" r="7" /><circle cx="270" cy="220" r="7" /><circle cx="480" cy="160" r="8" /></g>
  <circle cx="380" cy="120" r="11" fill="#EA6B2E" />
  <circle cx="380" cy="120" r="20" stroke="#EA6B2E" stroke-opacity=".35" stroke-width="1.5" />
</svg>

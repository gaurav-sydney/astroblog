---
import '../styles/global.css';
import { SITE } from '../config';
import Seo from '../components/Seo.astro';
import type { PostMeta } from '../lib/seo';
interface Props {
  title?: string; description?: string; type?: 'website' | 'article';
  image?: string; noindex?: boolean; post?: Omit<PostMeta, 'url' | 'image'>;
}
const { title, description = SITE.tagline, type = 'website', image, noindex, post } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <Seo title={fullTitle} description={description} type={type} image={image} noindex={noindex} post={post} />
  <meta name="theme-color" content="#15171C" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site dark">
    <div class="wrap bar">
      <a class="brand" href="/"><span class="dot" aria-hidden="true"></span>Automation Worker</a>
      <nav>
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Writing</a>
        <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
        <a href="/#assistant">Ask</a>
        <a href="/#subscribe" class="sub">Subscribe</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site dark">
    <div class="wrap foot">
      <span class="mono">© {new Date().getFullYear()} Automation Worker · by {SITE.author}</span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </footer>
</body>
</html>
<style>
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 18px; padding-bottom: 18px; flex-wrap: wrap; }
  .brand { font: 700 18px/1 var(--display); color: var(--paper) !important; text-decoration: none; display: flex; align-items: center; gap: 10px; letter-spacing: -.01em; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--teal); box-shadow: 14px 0 0 -3px var(--orange); margin-right: 12px; }
  nav { display: flex; gap: 22px; font: 500 14px/1 var(--display); }
  nav a { color: var(--paper) !important; opacity: .75; text-decoration: none; }
  nav a:hover, nav a[aria-current=page] { opacity: 1; }
  nav .sub { color: var(--teal) !important; opacity: 1; }
  .foot { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 28px; padding-bottom: 28px; font-size: 13px; opacity: .8; }
</style>

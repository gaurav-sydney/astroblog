   "parameters": {
    "jsCode": "const CONFIG = {           // = vendor_config in delivery/automation-worker/.../integrations/n8n/bindings.yaml\n  tenant: 'automation-worker',\n  list_id: 2,                  // automation-worker-subscribers\n  doi_template_id: null,       // TO SET: the Brevo double opt-in template id\n  redirect_url: 'https://automationworker.io/subscribed',\n  from_name: 'Automation Worker',\n  from_email: null,            // TO SET: the authenticated automationworker.io sender\n};\n// audience.subscribe: hand the reader to Brevo's double opt-in and stop (vendors/brevo.py Brevo.subscribe).\nconst req = $input.first().json, h = req.headers || {}, b = req.body || {};\nconst fromForm = $('Site form').isExecuted;\nconst fail = (error, retryable = false) => [{ json: { ok: false, error, retryable } }];\nif (!fromForm && h['x-tenant'] !== CONFIG.tenant) return fail('not authorised for this tenant');\nif (fromForm && b.website) return fail('refused');                       // honeypot field the site hides\nconst email = String(b.email || '').trim();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) return fail('a valid email is required');\nif (!CONFIG.doi_template_id) return fail('doi_template_id is not configured');\nconst brevo = { email, includeListIds: [CONFIG.list_id], templateId: CONFIG.doi_template_id,\n                redirectionUrl: CONFIG.redirect_url };\nif (!fromForm && b.attributes && Object.keys(b.attributes).length) brevo.attributes = b.attributes;\nreturn [{ json: { ok: true, email, brevo } }];"

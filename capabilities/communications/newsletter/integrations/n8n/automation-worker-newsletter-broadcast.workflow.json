    "jsCode": "// Brevo is the sent-log: an earlier campaign named post:<id> is never sent again; a draft left by a failed\n// sendNow is sent, not duplicated.\nconst want = $('Check request').first().json.create.name;\nconst found = ($input.first().json.campaigns || []).find((c) => c.name === want);\nconst action = !found ? 'create' : (found.status === 'draft' ? 'send' : 'done');\nreturn [{ json: { action, id: found ? found.id : null } }];"

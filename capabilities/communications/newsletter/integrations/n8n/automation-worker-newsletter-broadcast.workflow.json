   "parameters": {
    "jsCode": "const CONFIG = {           // = vendor_config in delivery/automation-worker/.../integrations/n8n/bindings.yaml\n  tenant: 'automation-worker',\n  list_id: 2,                  // automation-worker-subscribers\n  doi_template_id: null,       // TO SET: the Brevo double opt-in template id\n  redirect_url: 'https://automationworker.io/subscribed',\n  from_name: 'Automation Worker',\n  from_email: null,            // TO SET: the authenticated automationworker.io sender\n};\n// campaign.send_broadcast: one campaign per post, named post:<id> (vendors/brevo.py Brevo.send_broadcast).\nconst req = $input.first().json, h = req.headers || {}, post = (req.body || {}).post || {};\nconst fail = (error) => [{ json: { ok: false, error, retryable: false } }];\nif (h['x-tenant'] !== CONFIG.tenant) return fail('not authorised for this tenant');\nif (!post.title || !post.url) return fail('post.title and post.url are required');\nif (!CONFIG.from_email) return fail('from_email is not configured');\nconst id = post.id || String(post.url).split('?')[0].split('#')[0].replace(/\\/+$/, '').split('/').pop();\nif (!id) return fail('a post needs an id or a url with a slug');\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#x27;');\nconst link = `<p><a href=\"${esc(post.url)}\">Read \"${esc(post.title)}\" on the blog</a></p>`;\nconst html = post.html ? post.html + link : `<h1>${esc(post.title)}</h1><p>${esc(post.excerpt || '')}</p>${link}`;\nreturn [{ json: { ok: true, post: id, create: { name: `post:${id}`, subject: post.title, htmlContent: html,\n  sender: { name: CONFIG.from_name, email: CONFIG.from_email }, recipients: { listIds: [CONFIG.list_id] } } } }];"
   },
